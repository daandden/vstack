{
  "name": "vstack-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --timeout 30000 --path-ignore-patterns '**/*.browser.test.ts' && for file in tests/*.browser.test.ts; do bun test --timeout 30000 \"$file\" || exit; done",
    "check-register": "bun scripts/check-register.ts",
    "reader:build": "nuxt generate reader && bun reader/ship.ts"
  },
  "dependencies": {
    "pele": "1.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.150",
    "@nuxt/ui": "4.12.0",
    "@tanstack/charts": "1.5.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "4.6.3",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite-plus": "1.4.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}

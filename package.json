{
  "name": "vstack-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun scripts/test.ts",
    "check-register": "bun scripts/check-register.ts",
    "typecheck": "bun --bun tsc --project tsconfig.bun.json",
    "reader:prepare": "bun --bun nuxt prepare reader",
    "reader:typecheck": "bun run reader:prepare && bun --bun vue-tsc --build reader/tsconfig.json --noEmit",
    "reader:build": "bun reader/build.ts && bun reader/ship.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.1",
    "pele": "1.12.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.150",
    "@nuxt/ui": "4.12.0",
    "@oh-my-pi/pi-ai": "19.0.0",
    "@oh-my-pi/pi-coding-agent": "19.0.0",
    "@oh-my-pi/pi-tui": "19.0.0",
    "@tanstack/charts": "1.5.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vueuse/nuxt": "15.0.0",
    "drizzle-kit": "0.31.8",
    "nuxt": "4.6.3",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}

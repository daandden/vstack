{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["bun", "node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "plugin/**/*.ts",
    ".omp/skills/verify-vstack/scripts/**/*.ts",
    "reader/ship.ts"
  ],
  "exclude": ["node_modules", "reader/.nuxt", "reader/.output", "plugin/skills/flow-page/reader"]
}
